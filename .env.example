# Backend runtime
NODE_ENV=development
PORT=3100
HOST=0.0.0.0
DATABASE_URL=postgresql://localhost:5432/youtube_os
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@youtubeos.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional Redis. The backend uses an in-memory fallback when unset or unavailable.
REDIS_URL=

# Optional YouTube Data API and OAuth server credentials
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# Frontend build-time public configuration (never put secrets in VITE_* values)
VITE_PLATFORM_API_BASE_URL=http://localhost:3100/api/v1
VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_REDIRECT_URI=http://localhost:5174/youtube-os/oauth/youtube/callback
VITE_YOUTUBE_CHANNEL_ID=
VITE_SUPPORT_EMAIL=support@example.com
VITE_USER_DISPLAY_NAME=Creator
VITE_USER_AVATAR_URL=
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_GITHUB_URL=
VITE_SITE_URL=https://example.com/youtube-os/
