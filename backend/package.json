{
  "name": "@aiarbitech/youtube-os-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AIArbiTech YouTube OS independent platform backend foundation",
  "type": "module",
  "main": "dist/app/server.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
