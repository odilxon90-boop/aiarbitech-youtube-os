{
  "name": "@aiarbitech/youtube-os-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/app/server.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts --down",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/compress": "^8.1.0",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "ioredis": "^5.6.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "prisma": "^6.19.0",
    "typescript": "^5.9.1",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}"engines": {
  "node": "24.x"
}