generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Infrastructure metadata for this independently deployed platform.
/// Business entities are prohibited until Gate 0 authorizes their introduction.
model PlatformRuntimeMetadata {
  id              String   @id @default(uuid()) @db.Uuid
  platformId      String   @unique
  platformVersion String
  initializedAt   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("platform_runtime_metadata")
}
