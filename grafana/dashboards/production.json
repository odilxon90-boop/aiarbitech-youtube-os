{
  "uid": "youtube-os-production",
  "title": "YouTube OS - Production",
  "tags": ["youtube-os", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }] },
  "panels": [
    { "type": "row", "title": "System Health", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "type": "gauge", "title": "CPU Usage", "datasource": "$datasource", "targets": [{ "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } } }, "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 } },
    { "type": "gauge", "title": "Memory Usage", "datasource": "$datasource", "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } } }, "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 } },
    { "type": "gauge", "title": "Disk Usage", "datasource": "$datasource", "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } } }, "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 } },
    { "type": "row", "title": "API Performance", "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 } },
    { "type": "timeseries", "title": "Request Rate", "datasource": "$datasource", "targets": [{ "expr": "sum(rate(http_requests_total{service=\"youtube-os\"}[5m]))", "legendFormat": "requests/sec", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } }, "gridPos": { "x": 0, "y": 10, "w": 8, "h": 8 } },
    { "type": "timeseries", "title": "P95 API Latency", "datasource": "$datasource", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"youtube-os\"}[5m])) by (le))", "legendFormat": "p95", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } }, "gridPos": { "x": 8, "y": 10, "w": 8, "h": 8 } },
    { "type": "timeseries", "title": "API Error Rate", "datasource": "$datasource", "targets": [{ "expr": "100 * sum(rate(http_requests_total{service=\"youtube-os\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"youtube-os\"}[5m]))", "legendFormat": "5xx %", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "x": 16, "y": 10, "w": 8, "h": 8 } },
    { "type": "row", "title": "Database and Redis", "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 } },
    { "type": "timeseries", "title": "PostgreSQL Connections", "datasource": "$datasource", "targets": [{ "expr": "pg_stat_activity_count{datname=\"neondb\"}", "legendFormat": "{{state}}", "refId": "A" }], "gridPos": { "x": 0, "y": 19, "w": 6, "h": 8 } },
    { "type": "timeseries", "title": "PostgreSQL Query Time", "datasource": "$datasource", "targets": [{ "expr": "rate(pg_stat_database_blk_read_time_seconds_total{datname=\"neondb\"}[5m]) + rate(pg_stat_database_blk_write_time_seconds_total{datname=\"neondb\"}[5m])", "legendFormat": "I/O time", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } }, "gridPos": { "x": 6, "y": 19, "w": 6, "h": 8 } },
    { "type": "gauge", "title": "PostgreSQL Cache Hit Rate", "datasource": "$datasource", "targets": [{ "expr": "100 * sum(pg_stat_database_blks_hit{datname=\"neondb\"}) / (sum(pg_stat_database_blks_hit{datname=\"neondb\"}) + sum(pg_stat_database_blks_read{datname=\"neondb\"}))", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "x": 12, "y": 19, "w": 6, "h": 8 } },
    { "type": "timeseries", "title": "Redis Memory, Hit Rate, Evictions", "datasource": "$datasource", "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "memory", "refId": "A" }, { "expr": "100 * rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))", "legendFormat": "hit rate", "refId": "B" }, { "expr": "rate(redis_evicted_keys_total[5m])", "legendFormat": "evictions/sec", "refId": "C" }], "gridPos": { "x": 18, "y": 19, "w": 6, "h": 8 } },
    { "type": "row", "title": "User Activity", "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 } },
    { "type": "timeseries", "title": "Active Users", "datasource": "$datasource", "targets": [{ "expr": "youtube_os_active_users", "legendFormat": "active users", "refId": "A" }], "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "New Sign-ups", "datasource": "$datasource", "targets": [{ "expr": "sum(increase(youtube_os_signups_total[1d]))", "legendFormat": "daily sign-ups", "refId": "A" }, { "expr": "sum(increase(youtube_os_signups_total[7d]))", "legendFormat": "weekly sign-ups", "refId": "B" }], "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 } }
  ]
}
