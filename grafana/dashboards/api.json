{
  "uid": "youtube-os-api",
  "title": "YouTube OS - API Performance",
  "tags": ["youtube-os", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }, { "name": "route", "type": "query", "datasource": "$datasource", "query": "label_values(http_requests_total{service=\"youtube-os\"}, route)", "includeAll": true, "multi": true }] },
  "panels": [
    { "type": "timeseries", "title": "Requests per Second by Route", "datasource": "$datasource", "targets": [{ "expr": "sum by(route) (rate(http_requests_total{service=\"youtube-os\",route=~\"$route\"}[5m]))", "legendFormat": "{{route}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } }, "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "Latency Percentiles", "datasource": "$datasource", "targets": [{ "expr": "histogram_quantile(0.50, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"youtube-os\",route=~\"$route\"}[5m])))", "legendFormat": "p50", "refId": "A" }, { "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"youtube-os\",route=~\"$route\"}[5m])))", "legendFormat": "p95", "refId": "B" }, { "expr": "histogram_quantile(0.99, sum by(le) (rate(http_request_duration_seconds_bucket{service=\"youtube-os\",route=~\"$route\"}[5m])))", "legendFormat": "p99", "refId": "C" }], "fieldConfig": { "defaults": { "unit": "s" } }, "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "HTTP Status Rate", "datasource": "$datasource", "targets": [{ "expr": "sum by(status) (rate(http_requests_total{service=\"youtube-os\",route=~\"$route\"}[5m]))", "legendFormat": "{{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } }, "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 } },
    { "type": "timeseries", "title": "5xx Error Rate", "datasource": "$datasource", "targets": [{ "expr": "100 * sum(rate(http_requests_total{service=\"youtube-os\",route=~\"$route\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"youtube-os\",route=~\"$route\"}[5m]))", "legendFormat": "5xx %", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent" } }, "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 } }
  ]
}
