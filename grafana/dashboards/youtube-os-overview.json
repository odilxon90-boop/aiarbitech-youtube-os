{
  "dashboard": {
    "id": null,
    "uid": "youtube-os-overview",
    "title": "YouTube OS - Production Overview",
    "tags": ["youtube-os", "production"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Total Requests per Second",
        "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (service)", "legendFormat": "{{service}}"}],
        "fieldConfig": {"defaults": {"custom": {"axisLabel": "req/s", "drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "timeseries",
        "title": "Average Latency (ms)",
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service)) * 1000", "legendFormat": "p95 {{service}}"},
          {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service)) * 1000", "legendFormat": "p50 {{service}}"}
        ],
        "fieldConfig": {"defaults": {"custom": {"axisLabel": "ms", "drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "timeseries",
        "title": "Error Rate (%)",
        "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (service) / sum(rate(http_requests_total[5m])) by (service) * 100", "legendFormat": "{{service}}"}],
        "fieldConfig": {"defaults": {"custom": {"axisLabel": "%", "drawStyle": "line", "fillOpacity": 10}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "stat",
        "title": "Active Sessions",
        "targets": [{"expr": "sum(active_sessions)", "legendFormat": "Total"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}}}
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "type": "table",
        "title": "Per-Endpoint Metrics",
        "targets": [
          {"expr": "sum(rate(http_requests_total[5m])) by (endpoint, method)", "format": "table", "instant": true},
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint)) * 1000", "format": "table", "instant": true}
        ]
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "type": "timeseries",
        "title": "Top 5 Failing Endpoints",
        "targets": [{"expr": "topk(5, sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (endpoint))", "legendFormat": "{{endpoint}}"}],
        "fieldConfig": {"defaults": {"custom": {"axisLabel": "errors/s", "drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "type": "stat",
        "title": "Service Health",
        "targets": [
          {"expr": "up{job=\"youtube-os-backend\"}", "legendFormat": "Backend"},
          {"expr": "up{job=\"youtube-os-frontend\"}", "legendFormat": "Frontend"},
          {"expr": "up{job=\"prometheus\"}", "legendFormat": "Prometheus"}
        ],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}]}}
      }
    ]
  }
}
